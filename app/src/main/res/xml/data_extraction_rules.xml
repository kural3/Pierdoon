<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer on Android 12+.
   The computer pairing stays on this phone: its token would let a restored copy drive the computer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pc_remote.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pc_remote.xml" />
    </device-transfer>
</data-extraction-rules>
